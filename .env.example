# Local commands load .env; production hosts supply environment variables.
PORT=3000
NODE_ENV=development
# Exact browser origin if deploying the frontend separately:
# CLIENT_ORIGIN=https://your-game.vercel.app
# Public URL, set BEFORE building the Vercel frontend:
# VITE_SERVER_URL=https://your-persistent-backend.example.com

# Optional, PRIVATE server-side only. Never prefix this with VITE_.
OPENAI_API_KEY=
OPENAI_BOT_MODEL=gpt-4.1-mini
OPENAI_BOTS_ENABLED=true
