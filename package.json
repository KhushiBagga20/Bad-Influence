{
  "name": "petty-theft",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx backend/src/server.ts",
    "dev:frontend": "vite --config frontend/vite.config.ts",
    "start": "node --env-file-if-exists=.env --import tsx backend/src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build --config frontend/vite.config.ts",
    "test": "node --import tsx --test tests/backend/*.test.ts tests/integration/*.test.ts",
    "test:production": "node tests/integration/production-server.test.mjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "phaser": "^3.90.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.5"
  }
}
